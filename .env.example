# AIDebug LLM configuration
# Copy this file to .env. The real .env is ignored by Git.
# Leave AIDEBUG_LLM_PROVIDER=auto to select the only uncommented provider.
AIDEBUG_LLM_PROVIDER=auto

# Anthropic Claude
# ANTHROPIC_API_KEY=replace_with_your_key
# AIDEBUG_ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI
# OPENAI_API_KEY=replace_with_your_key
# AIDEBUG_OPENAI_MODEL=gpt-5.6-terra

# Google Gemini
# GEMINI_API_KEY=replace_with_your_key
# AIDEBUG_GEMINI_MODEL=gemini-3.6-flash

# Local Ollama: no cloud API key is required.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# AIDEBUG_OLLAMA_MODEL=qwen3:8b

# Optional global overrides
# AIDEBUG_AI_MODEL=provider-specific-model-id
# AIDEBUG_LLM_BASE_URL=https://custom-openai-compatible-endpoint/v1
